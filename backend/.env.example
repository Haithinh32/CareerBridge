# Cơ sở dữ liệu: SQLite cho dev, PostgreSQL cho production
# DATABASE_URL=postgresql+asyncpg://careerbridge:careerbridge@localhost:5432/careerbridge
DATABASE_URL=sqlite+aiosqlite:///./careerbridge.db

JWT_SECRET=doi-chuoi-nay-thanh-chuoi-bi-mat-dai
JWT_EXPIRE_MINUTES=1440

FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=./uploads

# Đăng nhập LinkedIn (OpenID Connect) - tạo app tại https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback

# Tác vụ chạy ngầm (thu thập tin, chụp chỉ số chất lượng, học trọng số)
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_MINUTES=60

# Danh sách URL feed đối tác (JSON), phân cách bằng dấu phẩy
PARTNER_FEED_URLS=
# Danh sách trang được phép thu thập (sẽ kiểm tra robots.txt trước khi tải)
CRAWL_SEED_URLS=
